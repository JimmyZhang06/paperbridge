{
  "name": "paperbridge",
  "version": "0.2.0",
  "description": "英文论文精读与学习工具",
  "author": "Suyue",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build && node scripts/copy-resources.mjs",
    "start": "tsx server/index.ts",
    "desktop:build": "npm run parser:build && npm run build && electron-builder --win nsis",
    "desktop:dir": "npm run parser:build && npm run build && electron-builder --win dir",
    "parser:build": "node scripts/build-parser.mjs"
  },
  "dependencies": {
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "katex": "^0.18.9",
    "lucide-react": "^1.48.0",
    "multer": "^2.4.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-pdf": "^11.0.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "electron": "^40.0.0",
    "electron-builder": "^26.0.12",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "main": "desktop/main.cjs",
  "build": {
    "appId": "app.suyue.reader",
    "productName": "溯页",
    "electronDist": "node_modules/electron/dist",
    "asar": true,
    "files": [
      "desktop/**/*",
      "dist/**/*",
      "dist-server/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ],
      "artifactName": "Suyue-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "溯页"
    },
    "extraResources": [
      {
        "from": "build/parser/suyue-pdf-engine",
        "to": "parser"
      }
    ]
  },
  "engines": {
    "node": ">=24.11.0"
  }
}
